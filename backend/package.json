{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --watch src --ext ts,json --exec ts-node src/index.ts",
    "build": "cross-env DB_MODE=supabase node scripts/prisma-generate.js && tsc",
    "postinstall": "node scripts/prisma-generate.js",
    "db:generate": "node scripts/prisma-generate.js",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:push": "npm run db:push:local",
    "db:push:local": "cross-env DB_MODE=local DATABASE_URL=file:./data/lead-hunter.db prisma db push --schema prisma/schema.sqlite.prisma",
    "db:push:supabase": "cross-env DB_MODE=supabase prisma db push --schema prisma/schema.prisma",
    "db:generate:local": "cross-env DB_MODE=local node scripts/prisma-generate.js",
    "db:generate:supabase": "cross-env DB_MODE=supabase node scripts/prisma-generate.js",
    "seed": "ts-node src/scripts/seed.ts",
    "db:dedupe-leads": "ts-node src/scripts/remove-duplicate-leads.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/natural": "^5.1.5",
    "@types/node": "^25.6.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "apify-client": "^2.23.1",
    "axios": "^1.16.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jimp": "^1.6.1",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.12.42",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "natural": "^8.1.1",
    "node-cron": "^4.2.1",
    "prisma": "^6.16.0",
    "sharp": "^0.34.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^7.0.0"
  }
}
