# Local development — SQLite file storage (default when DB_MODE is unset in dev)
DB_MODE=local
DATABASE_URL=file:./data/lead-hunter.db

NODE_ENV=development
ENV=development
PORT=5001

ADMIN_EMAIL=admin@leadhunter.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Platform Admin

JWT_ACCESS_SECRET=local-dev-secret
JWT_REFRESH_SECRET=local-dev-refresh-secret
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
# Optional in local dev. Set this to test encrypted settings storage.
SETTINGS_ENCRYPTION_KEY=

REDIS_URL=redis://localhost:6379
# Set USE_CLOUD_REDIS=true and your Upstash URL only if you need cloud Redis in dev
USE_CLOUD_REDIS=false
APIFY_API_TOKEN=
APIFY_LINKEDIN_PROFILE_COMMENTS_ACTOR=harvestapi/linkedin-profile-comments
APIFY_LINKEDIN_PROFILE_ACTOR=dev_fusion/linkedin-profile-scraper
APIFY_MONTHLY_COMMENT_LIMIT=2500
TARGET_SCRAPE_MAX_ITEMS=20
TARGET_SCRAPE_POSTED_LIMIT=24h
CONTACT_COMPASS_MONTHLY_LOOKUP_LIMIT=500
HUNTER_API_KEY=
CONTACTOUT_API_TOKEN=
APOLLO_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Local callback example
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5001/api/google-sheets/callback
MAX_PAID_PHONE_LOOKUPS_PER_LEAD=2
OPEN_ROUTER_API=
AI_SERVICE_URL=http://localhost:8000
CRON_INTERVAL=0 * * * *
ENABLE_CRON_DEV=false
