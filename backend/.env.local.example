# Local development — SQLite file storage (default when DB_MODE is unset in dev)
DB_MODE=local
DATABASE_URL=file:./data/lead-hunter.db

NODE_ENV=development
ENV=development
PORT=5001

ADMIN_EMAIL=admin@leadhunter.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Platform Admin

JWT_ACCESS_SECRET=local-dev-secret
JWT_REFRESH_SECRET=local-dev-refresh-secret
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

REDIS_URL=redis://localhost:6379
APIFY_API_TOKEN=
APIFY_LINKEDIN_PROFILE_COMMENTS_ACTOR=harvestapi/linkedin-profile-comments
TARGET_SCRAPE_MAX_ITEMS=20
TARGET_SCRAPE_POSTED_LIMIT=24h
OPEN_ROUTER_API=
AI_SERVICE_URL=http://localhost:8000
CRON_INTERVAL=0 * * * *
ENABLE_CRON_DEV=false
