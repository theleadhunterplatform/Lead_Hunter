# ── Database mode ─────────────────────────────────────────────
# local    → SQLite file at ./data/lead-hunter.db (default in development)
# supabase → PostgreSQL on Supabase (default in production)
DB_MODE=supabase

# ── Supabase (use when DB_MODE=supabase) ──────────────────────
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Server ────────────────────────────────────────────────────
NODE_ENV=production
ENV=production
PORT=5001

# ── Auth ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ── Redis / Upstash ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Use cloud Redis in dev only when needed (e.g. deployed preview). BullMQ burns Upstash free quota fast.
USE_CLOUD_REDIS=false

# ── External APIs ─────────────────────────────────────────────
APIFY_API_TOKEN=
APIFY_LINKEDIN_PROFILE_COMMENTS_ACTOR=harvestapi/linkedin-profile-comments
APIFY_MONTHLY_COMMENT_LIMIT=2500
TARGET_SCRAPE_MAX_ITEMS=20
TARGET_SCRAPE_POSTED_LIMIT=24h
CONTACT_COMPASS_MONTHLY_LOOKUP_LIMIT=500
OPEN_ROUTER_API=
AI_SERVICE_URL=http://localhost:8000

# ── Cron ──────────────────────────────────────────────────────
CRON_INTERVAL=0 * * * *
ENABLE_CRON_DEV=false
