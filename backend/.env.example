# ── Database mode ─────────────────────────────────────────────
# local    → SQLite file at ./data/lead-hunter.db (default in development)
# supabase → PostgreSQL on Supabase (default in production)
DB_MODE=supabase

# ── Supabase (use when DB_MODE=supabase) ──────────────────────
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Server ────────────────────────────────────────────────────
NODE_ENV=production
ENV=production
PORT=5001

# ── Auth ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ── Redis / Upstash ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Use cloud Redis in dev only when needed (e.g. deployed preview). BullMQ burns Upstash free quota fast.
USE_CLOUD_REDIS=false

# ── External APIs ─────────────────────────────────────────────
APIFY_API_TOKEN=
APIFY_LINKEDIN_PROFILE_COMMENTS_ACTOR=harvestapi/linkedin-profile-comments
APIFY_MONTHLY_COMMENT_LIMIT=2500
# Optional stable id per deploy instance for Apify token leasing (e.g. render-node-1)
WORKER_ID=
TARGET_SCRAPE_MAX_ITEMS=20
TARGET_SCRAPE_POSTED_LIMIT=24h
# Min hours between Apify calls for the same watchlist target (saves tokens)
TARGET_SCRAPE_MIN_HOURS=6
CONTACT_COMPASS_MONTHLY_LOOKUP_LIMIT=500
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Example: https://your-api-domain.com/api/google-sheets/callback
GOOGLE_OAUTH_REDIRECT_URI=
# Optional — get a key at https://openrouter.ai/keys (required for strategic intel reports)
OPEN_ROUTER_API=
# Optional — defaults to google/gemini-2.5-flash
OPEN_ROUTER_INTEL_MODEL=
# Cap output tokens (OpenRouter free/low credits reject huge defaults). Default: 2048
OPEN_ROUTER_INTEL_MAX_TOKENS=2048
AI_SERVICE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# Optional: comma-separated URLs to ping (overrides auto-detect from FRONTEND_URL + AI_SERVICE_URL + RENDER_EXTERNAL_URL)
# KEEP_ALIVE_URLS=https://your-api.onrender.com/health,https://your-web.onrender.com,https://your-ai.onrender.com/health

# Optional: comma-separated platform owner emails (get system_owner on seed)
# PLATFORM_OWNER_EMAILS=owner@yourcompany.com

# ── Email (invites, password reset, CRM outreach) ───────────
# Option A — Resend (recommended): https://resend.com
RESEND_API_KEY=
EMAIL_FROM=Lead Hunter <noreply@yourdomain.com>

# Option B — SMTP (if not using Resend)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ── Security ──────────────────────────────────────────────────
# Required in production for Chrome extension bulk ingest
EXTENSION_INGEST_API_KEY=
# Required in production: base64-encoded 32-byte key used to encrypt provider tokens in DB
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=
# Set to false to disable public self-registration (invite-only)
ALLOW_OPEN_REGISTRATION=true
# New signups require platform admin approval before login (default: true)
REQUIRE_SIGNUP_APPROVAL=true

# ── Cron ──────────────────────────────────────────────────────
CRON_INTERVAL=*/30 * * * *
ENABLE_CRON_DEV=false
