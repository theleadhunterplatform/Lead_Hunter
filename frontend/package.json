{
  "name": "leadhunterclub",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run prisma generate -w apps/web",
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "lint": "npm run lint -w apps/web",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "overrides": {
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "prettier": "^3.4.0",
    "ws": "^8.20.1"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "firebase": "^12.15.0"
  }
}
