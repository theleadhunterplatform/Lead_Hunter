# =============================================================================
# Lead Hunter Club — Environment Variables
# =============================================================================
# Copy this file to .env.local (root) and apps/web/.env.local, then fill in
# your real values. Never commit .env, .env.local, or any file containing
# real credentials to git.
#
# CRITICAL: The app validates these on startup. If a required variable is
# missing, the application will refuse to start with a clear error message.
# =============================================================================

# ─── App Configuration ───
NEXT_PUBLIC_APP_URL=https://leadhunterclub.com

# ─── Firebase Client (public - safe) ───
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ─── Firebase Admin (server-side only) ───
# Either set FIREBASE_SERVICE_ACCOUNT_KEY to the full JSON string, or
# set FIREBASE_SERVICE_ACCOUNT_PATH to a file path (e.g. ./serviceAccountKey.json).
# The file is gitignored — do NOT commit it.
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=

# ─── Admin Registration Key ───
ADMIN_REGISTRATION_KEY=your-secret-key

# ─── Database (PostgreSQL via Supabase) ───
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ─── Stripe (server-side only) ───
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── External Lead API ───
NEXT_PUBLIC_API_URL=https://your-api.example.com/api
EXTERNAL_API_EMAIL=your-api-email
EXTERNAL_API_PASSWORD=your-api-password

# ─── Email (Resend) ───
RESEND_API_KEY=
EMAIL_FROM=noreply@leadhunterclub.com
ADMIN_NOTIFICATION_EMAIL=team@leadhunterclub.com

# ─── Rate Limiting (Upstash Redis - optional) ───
# Falls back to in-memory rate limiter if not set.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── API URLs (optional — defaults to same-origin) ───
NEXT_PUBLIC_API_URL=
API_URL=
